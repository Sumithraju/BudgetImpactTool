# Copy to .env and fill in. .env is git-ignored and must never be committed.

# --- database -------------------------------------------------------------
BIET_DATABASE_URL=postgresql+psycopg://biet:CHANGE_ME@localhost:5433/biet

# --- network (OPTIONAL) ---------------------------------------------------
# Every endpoint is reachable without a proxy. Set these only when running
# behind one. Format: http://user:password@host:port
#
# Two mechanisms, because two things make outbound calls. Ingestion reads the
# BIET_-prefixed pair below. The API — comparator discovery calls Open Targets
# and Reactome while serving a request — goes through httpx, which reads the
# standard uppercase names instead. docker-compose.yml passes both through, so
# under Docker you can set either; running locally, set the pair that matches
# the process you are running.
# BIET_HTTP_PROXY=
# BIET_HTTPS_PROXY=
# HTTP_PROXY=
# HTTPS_PROXY=
# NO_PROXY=

# --- tuning ---------------------------------------------------------------
# BIET_REQUEST_TIMEOUT_S=90
# BIET_REQUEST_RETRIES=3
