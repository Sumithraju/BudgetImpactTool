# Copy to .env and fill in. .env is git-ignored and must never be committed.

# --- database -------------------------------------------------------------
BIET_DATABASE_URL=postgresql+psycopg://biet:CHANGE_ME@localhost:5433/biet

# --- network (OPTIONAL) ---------------------------------------------------
# Every ingestion endpoint is reachable without a proxy. Set these only when
# running behind one. Format: http://user:password@host:port
# BIET_HTTP_PROXY=
# BIET_HTTPS_PROXY=

# --- tuning ---------------------------------------------------------------
# BIET_REQUEST_TIMEOUT_S=90
# BIET_REQUEST_RETRIES=3
