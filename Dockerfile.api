# The API and the ingestion CLI. One image serves both — they share the same
# package and the same dependency set, and a second image would only duplicate
# a 400 MB layer to run a different entrypoint.
FROM python:3.12-slim AS base

# psycopg's binary wheel needs libpq at runtime; nothing else here compiles.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libpq5 curl \
    && rm -rf /var/lib/apt/lists/*

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app/backend/src:/app

WORKDIR /app

# Dependencies first, as their own layer: they change far less often than the
# source, so an ordinary code edit rebuilds in seconds rather than minutes.
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/ ./backend/
COPY data/ ./data/

# Not root. The API reads reference data and writes nothing outside the
# database, so it has no reason to hold write access to its own image.
RUN useradd --create-home --uid 10001 biet && chown -R biet:biet /app
USER biet

EXPOSE 8077

HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 \
    CMD curl -fsS http://localhost:8077/health || exit 1

CMD ["uvicorn", "biet_api.main:app", "--host", "0.0.0.0", "--port", "8077"]
